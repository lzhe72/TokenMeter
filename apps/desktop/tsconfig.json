{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"], "types": ["node", "electron-vite/node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron.vite.config.ts", "tests/**/*.ts"]
}
